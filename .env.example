# Copy to `.env` in the project root and fill in values.
# `.env` is gitignored — do not commit secrets.

# --- Phase 3: Groq (OpenAI-compatible chat completions) ---
GROQ_API_KEY=
# Optional; examples: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- Phase 2: Pinecone (only when using mf-index --backend pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX=mf-rag
